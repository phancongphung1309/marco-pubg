<Window x:Class="MouseStudio.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MouseStudio.Core.Localization"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        Foreground="#F3F4F6">

    <StackPanel Margin="20">

        <TextBlock
            Text="{loc:Tr ProfileName}"
            FontWeight="SemiBold"
            Margin="0,0,0,7"/>

        <TextBox
            x:Name="NameTextBox"
            Height="40"/>

        <TextBlock
            x:Name="ErrorText"
            FontSize="12"
            Foreground="{StaticResource DangerBrush}"
            Margin="0,6,0,0"
            Visibility="Collapsed"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,18,0,0">

            <Button
                Content="{loc:Tr Cancel}"
                Width="90"
                IsCancel="True"/>

            <Button
                Content="{loc:Tr Ok}"
                Width="90"
                Margin="10,0,0,0"
                IsDefault="True"
                Style="{StaticResource PrimaryButton}"
                Click="Ok_Click"/>

        </StackPanel>

    </StackPanel>

</Window>
