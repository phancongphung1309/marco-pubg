<Window x:Class="MouseStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MouseStudio.Core.Localization"
        Title="Mouse Studio"
        Width="900"
        SizeToContent="Height"
        MinWidth="820"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        Foreground="#F3F4F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===== Header ===== -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">

                <Border
                    Width="52"
                    Height="52"
                    CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="Assets/logo.png"
                            Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="PCP"
                        FontSize="26"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="https://github.com/phancongphung1309"
                        FontSize="13"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Button
                    Content="{loc:Tr Donate}"
                    Width="90"
                    ToolTip="{loc:Tr DonateTip}"
                    Click="Donate_Click"/>

                <Button
                    Content="{loc:Tr LanguageButton}"
                    Width="56"
                    Margin="8,0,0,0"
                    ToolTip="{loc:Tr LanguageTip}"
                    Click="Language_Click"/>

                <Button
                    x:Name="OverlayButton"
                    Content="{loc:Tr ShowOverlay}"
                    Width="130"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="Overlay_Click"/>

            </StackPanel>

        </Grid>


        <!-- ===== Settings ===== -->
        <Grid Grid.Row="2">

            <!-- Movement settings -->
            <Border x:Name="MovementPanel" Style="{StaticResource Card}" Padding="20">

            <StackPanel>

                <!-- Profile -->
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock
                            Text="{loc:Tr Profile}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                        <Border Style="{StaticResource KeyBadge}" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="F1…F12" Style="{StaticResource KeyBadgeText}" FontSize="11"/>
                        </Border>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal">

                        <Button
                            Content="{loc:Tr Import}"
                            Width="80"
                            ToolTip="{loc:Tr ImportTip}"
                            Click="ImportProfiles_Click"/>

                        <Button
                            Content="{loc:Tr Export}"
                            Width="80"
                            Margin="8,0,0,0"
                            ToolTip="{loc:Tr ExportTip}"
                            Click="ExportProfiles_Click"/>

                    </StackPanel>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="ProfileComboBox"
                            DisplayMemberPath="Name"
                            ToolTip="{loc:Tr ProfileListTip}"
                            SelectionChanged="ProfileComboBox_SelectionChanged"/>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">

                            <Button
                                x:Name="NewProfileButton"
                                Content="{loc:Tr New}"
                                Width="76"
                                Click="NewProfile_Click"/>

                            <Button
                                Content="{loc:Tr Rename}"
                                Width="88"
                                Margin="8,0,0,0"
                                Click="RenameProfile_Click"/>

                            <Button
                                x:Name="DeleteProfileButton"
                                Content="{loc:Tr Delete}"
                                Width="76"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteProfile_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,20,0,20"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="{loc:Tr MovementSettings}"
                            FontSize="17"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{loc:Tr MovementHint}"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="{loc:Tr MoveX}" Style="{StaticResource FieldLabel}"/>

                            <TextBox
                                x:Name="MoveXTextBox"
                                Text="0"
                                Height="40"/>

                            <TextBlock Text="{loc:Tr MoveXHint}" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="{loc:Tr MoveY}" Style="{StaticResource FieldLabel}"/>

                            <TextBox
                                x:Name="MoveYTextBox"
                                Text="5"
                                Height="40"/>

                            <TextBlock Text="{loc:Tr MoveYHint}" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="{loc:Tr Interval}" Style="{StaticResource FieldLabel}"/>

                            <Grid>

                                <TextBox
                                    x:Name="IntervalTextBox"
                                    Text="10"
                                    Height="40"
                                    Padding="12,8,45,8"/>

                                <TextBlock
                                    Text="ms"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="0,0,12,0"
                                    IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Text="{loc:Tr IntervalHint}" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="{loc:Tr ActiveDuration}" Style="{StaticResource FieldLabel}"/>

                            <Grid>

                                <TextBox
                                    x:Name="ActiveDurationTextBox"
                                    Text="5000"
                                    Height="40"
                                    Padding="12,8,45,8"/>

                                <TextBlock
                                    Text="ms"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="0,0,12,0"
                                    IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Text="{loc:Tr ActiveDurationHint}" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="{loc:Tr RepeatDelay}" Style="{StaticResource FieldLabel}"/>

                            <Grid>

                                <TextBox
                                    x:Name="RepeatDelayTextBox"
                                    Text="1000"
                                    Height="40"
                                    Padding="12,8,45,8"/>

                                <TextBlock
                                    Text="ms"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="0,0,12,0"
                                    IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Text="{loc:Tr RepeatDelayHint}" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </StackPanel>

            </Border>

        </Grid>


        <!-- ===== Console ===== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{loc:Tr Console}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- Script status -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                        <Ellipse
                            x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            Fill="{StaticResource MutedBrush}"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            x:Name="StatusText"
                            Text="{loc:Tr StatusStopped}"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"/>

                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Content="{loc:Tr Clear}"
                        Width="72"
                        Height="30"
                        FontSize="12"
                        Click="ClearConsole_Click"/>

                </Grid>

                <TextBox
                    Grid.Row="2"
                    x:Name="ConsoleTextBox"
                    Height="150"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Background="#080C11"
                    BorderBrush="#202A35"
                    FontFamily="Consolas"
                    FontSize="12"
                    Padding="12"/>

            </Grid>

        </Border>

    </Grid>

    </ScrollViewer>

</Window>
