<Window x:Class="MouseStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Studio"
        Width="900"
        SizeToContent="Height"
        MinWidth="820"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        Foreground="#F3F4F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===== Header ===== -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">

                <Border
                    Width="52"
                    Height="52"
                    CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="Assets/logo.png"
                            Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="PCP"
                        FontSize="26"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="https://github.com/phancongphung1309"
                        FontSize="13"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Button
                    Content="Donate"
                    Width="90"
                    ToolTip="Support the project"
                    Click="Donate_Click"/>

                <Button
                    x:Name="OverlayButton"
                    Content="Show Overlay"
                    Width="130"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="Overlay_Click"/>

            </StackPanel>

        </Grid>


        <!-- ===== Feature selector ===== -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton
                x:Name="MovementFeatureButton"
                Grid.Column="0"
                GroupName="Feature"
                Style="{StaticResource FeatureCard}"
                Checked="Feature_Checked">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="10"
                        Background="#1B2A40"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="&#xE7C2;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="20"
                            Foreground="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                        <TextBlock
                            Text="Movement"
                            FontSize="17"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Hold the Forward side button to drag the cursor."
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            TextWrapping="Wrap"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </RadioButton>


            <RadioButton
                x:Name="AutoFeatureButton"
                Grid.Column="2"
                GroupName="Feature"
                Style="{StaticResource FeatureCard}"
                Checked="Feature_Checked">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="10"
                        Background="#1B2A40"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="&#xE945;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="20"
                            Foreground="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                        <TextBlock
                            Text="Auto"
                            FontSize="17"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Hold Forward: fires and pulls down automatically."
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            TextWrapping="Wrap"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </RadioButton>

        </Grid>


        <!-- ===== Feature settings ===== -->
        <Grid Grid.Row="4">

            <!-- Movement settings -->
            <Border x:Name="MovementPanel" Style="{StaticResource Card}" Padding="20">

            <StackPanel>

                <!-- Profile (Movement only) -->
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock
                            Text="Profile"
                            FontSize="17"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                        <Border Style="{StaticResource KeyBadge}" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="F1…F12" Style="{StaticResource KeyBadgeText}" FontSize="11"/>
                        </Border>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal">

                        <Button
                            Content="Import"
                            Width="80"
                            ToolTip="Replace all profiles with the ones in a file"
                            Click="ImportProfiles_Click"/>

                        <Button
                            Content="Export"
                            Width="80"
                            Margin="8,0,0,0"
                            ToolTip="Save all profiles to a file"
                            Click="ExportProfiles_Click"/>

                    </StackPanel>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="ProfileComboBox"
                            DisplayMemberPath="Name"
                            ToolTip="F1 loads the 1st profile, F2 the 2nd, … (max 12)."
                            SelectionChanged="ProfileComboBox_SelectionChanged"/>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">

                            <Button
                                x:Name="NewProfileButton"
                                Content="New"
                                Width="76"
                                Click="NewProfile_Click"/>

                            <Button
                                Content="Rename"
                                Width="88"
                                Margin="8,0,0,0"
                                Click="RenameProfile_Click"/>

                            <Button
                                x:Name="DeleteProfileButton"
                                Content="Delete"
                                Width="76"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteProfile_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,20,0,20"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="Movement settings"
                            FontSize="17"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Saved automatically. Runs while the Forward side button is held."
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Horizontal movement" Style="{StaticResource FieldLabel}"/>

                            <TextBox
                                x:Name="MoveXTextBox"
                                Text="0"
                                Height="40"/>

                            <TextBlock Text="Negative = left, positive = right" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Vertical movement" Style="{StaticResource FieldLabel}"/>

                            <TextBox
                                x:Name="MoveYTextBox"
                                Text="5"
                                Height="40"/>

                            <TextBlock Text="Positive values move downward" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Interval" Style="{StaticResource FieldLabel}"/>

                            <Grid>

                                <TextBox
                                    x:Name="IntervalTextBox"
                                    Text="10"
                                    Height="40"
                                    Padding="12,8,45,8"/>

                                <TextBlock
                                    Text="ms"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="0,0,12,0"
                                    IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Text="Delay between each movement step" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Active duration" Style="{StaticResource FieldLabel}"/>

                            <Grid>

                                <TextBox
                                    x:Name="ActiveDurationTextBox"
                                    Text="5000"
                                    Height="40"
                                    Padding="12,8,45,8"/>

                                <TextBlock
                                    Text="ms"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="0,0,12,0"
                                    IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Text="Maximum time each activation can run" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Repeat delay" Style="{StaticResource FieldLabel}"/>

                            <Grid>

                                <TextBox
                                    x:Name="RepeatDelayTextBox"
                                    Text="1000"
                                    Height="40"
                                    Padding="12,8,45,8"/>

                                <TextBlock
                                    Text="ms"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="0,0,12,0"
                                    IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Text="Wait time before the next activation" Style="{StaticResource FieldHint}"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </StackPanel>

            </Border>


            <!-- Auto settings -->
            <Border
                x:Name="AutoPanel"
                Style="{StaticResource Card}"
                Padding="20"
                Visibility="Collapsed">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="Auto settings"
                            FontSize="17"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Saved automatically. In Auto, F1 switches the gun"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                    <!-- Gun -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                                Text="Gun"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Which pull-down pattern to use"
                                FontSize="12"
                                Foreground="{StaticResource MutedBrush}"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">

                            <StackPanel Orientation="Horizontal">

                                <RadioButton
                                    x:Name="GunM416Button"
                                    Content="M416"
                                    GroupName="AutoGun"
                                    Style="{StaticResource SegmentButton}"
                                    Checked="AutoOption_Checked"/>

                                <RadioButton
                                    x:Name="GunBerylButton"
                                    Content="Beryl"
                                    GroupName="AutoGun"
                                    Style="{StaticResource SegmentButton}"
                                    Checked="AutoOption_Checked"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource KeyBadge}"
                            HorizontalAlignment="Right"
                            ToolTip="Press F1 to switch (also in game)">
                            <TextBlock Text="F1" Style="{StaticResource KeyBadgeText}"/>
                        </Border>

                    </Grid>

                    <!-- How to use -->
                    <Border
                        Grid.Row="4"
                        Background="#0E151D"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE946;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource PrimaryBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Hold the Forward side button: LEFT is held for you and the cursor is pulled down until Forward is released."
                                FontSize="12"
                                Foreground="#C9D2DD"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </Grid>


        <!-- ===== Console ===== -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="16">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Console"
                        FontSize="15"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- Script status -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                        <Ellipse
                            x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            Fill="{StaticResource MutedBrush}"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            x:Name="StatusText"
                            Text="Stopped"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"/>

                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Content="Clear"
                        Width="72"
                        Height="30"
                        FontSize="12"
                        Click="ClearConsole_Click"/>

                </Grid>

                <TextBox
                    Grid.Row="2"
                    x:Name="ConsoleTextBox"
                    Height="150"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Background="#080C11"
                    BorderBrush="#202A35"
                    FontFamily="Consolas"
                    FontSize="12"
                    Padding="12"/>

            </Grid>

        </Border>

    </Grid>

    </ScrollViewer>

</Window>
