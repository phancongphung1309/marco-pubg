<Window x:Class="MouseStudio.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donate"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        Foreground="#F3F4F6">

    <StackPanel Margin="20">

        <TextBlock
            Text="Support Mouse Studio"
            FontSize="17"
            FontWeight="SemiBold"/>

        <TextBlock
            Text="If the app helps you, scan this code with your banking app (VietQR / Napas 247)."
            FontSize="12"
            Foreground="{StaticResource MutedBrush}"
            TextWrapping="Wrap"
            Margin="0,4,0,16"/>

        <!-- White background: the code must stay dark on light to scan. -->
        <Border
            Background="White"
            CornerRadius="12"
            Padding="8">
            <Image
                Source="Assets/donate-qr.jpg"
                Stretch="Uniform"
                RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <Button
            Content="Close"
            Width="90"
            HorizontalAlignment="Right"
            Margin="0,18,0,0"
            IsCancel="True"
            IsDefault="True"/>

    </StackPanel>

</Window>
